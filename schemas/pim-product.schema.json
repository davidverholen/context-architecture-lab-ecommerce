{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://context-architecture-commerce-lab.local/schemas/pim-product.schema.json",
  "title": "PIM Product",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pim_product_id",
    "family",
    "sku",
    "status",
    "attributes"
  ],
  "properties": {
    "pim_product_id": { "type": "string" },
    "family": { "type": "string", "enum": ["rug"] },
    "sku": { "type": "string" },
    "status": { "type": "string", "enum": ["draft", "enriched", "approved"] },
    "attributes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "material",
        "size",
        "color",
        "shape",
        "pile_height_mm",
        "care_instruction",
        "suitable_rooms",
        "style",
        "origin_country"
      ],
      "properties": {
        "material": { "type": "string" },
        "size": { "type": "string" },
        "color": { "type": "string" },
        "shape": { "type": "string" },
        "pile_height_mm": { "type": "number", "minimum": 0 },
        "care_instruction": { "type": "string" },
        "suitable_rooms": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "style": { "type": "string" },
        "origin_country": { "type": "string", "pattern": "^[A-Z]{2}$" }
      }
    }
  }
}
