{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://context-architecture-commerce-lab.local/schemas/shopify-order-created.schema.json",
  "title": "Shopify Order Created Sample",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "created_at",
    "currency",
    "customer",
    "shipping_address",
    "line_items",
    "total_price"
  ],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "created_at": { "type": "string" },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "customer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "email"],
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" }
      }
    },
    "shipping_address": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "address1", "city", "postal_code", "country_code"],
      "properties": {
        "name": { "type": "string" },
        "address1": { "type": "string" },
        "address2": { "type": "string" },
        "city": { "type": "string" },
        "postal_code": { "type": "string" },
        "country_code": { "type": "string", "pattern": "^[A-Z]{2}$" }
      }
    },
    "line_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "sku", "title", "quantity", "price", "product_family", "attributes"],
        "properties": {
          "id": { "type": "string" },
          "sku": { "type": "string" },
          "title": { "type": "string" },
          "quantity": { "type": "integer", "minimum": 1 },
          "price": { "type": "number", "minimum": 0 },
          "product_family": { "type": "string", "enum": ["rug"] },
          "attributes": {
            "type": "object",
            "additionalProperties": false,
            "required": ["material", "size", "color", "shape"],
            "properties": {
              "material": { "type": "string" },
              "size": { "type": "string" },
              "color": { "type": "string" },
              "shape": { "type": "string" }
            }
          }
        }
      }
    },
    "total_price": { "type": "number", "minimum": 0 }
  }
}
