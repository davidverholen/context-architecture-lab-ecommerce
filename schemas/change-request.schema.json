{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://context-architecture-commerce-lab.local/schemas/change-request.schema.json",
  "title": "Agentic Change Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "change_request_id",
    "title",
    "change_type",
    "affected_domains",
    "risk_level",
    "summary",
    "proposed_by",
    "requires_review",
    "context_pack",
    "created_at"
  ],
  "properties": {
    "change_request_id": { "type": "string" },
    "title": { "type": "string" },
    "change_type": {
      "type": "string",
      "enum": [
        "product_projection",
        "order_integration",
        "fulfillment",
        "customer_data",
        "cloud_run",
        "governance",
        "docs_only"
      ]
    },
    "affected_domains": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "risk_level": { "type": "string", "enum": ["low", "medium", "high"] },
    "summary": { "type": "string" },
    "proposed_by": { "type": "string" },
    "requires_review": { "type": "boolean" },
    "context_pack": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "created_at": { "type": "string" }
  }
}
