# Local development defaults. Do not commit real secrets.
COMMERCE_INTEGRATION_SERVICE_PORT=8082
MOCK_WMS_PORT=8083
MOCK_PIM_PORT=8084
GOVERNANCE_SERVICE_PORT=8085
PRODUCT_PROJECTION_SERVICE_PORT=8086
MOCK_SHOPIFY_PORT=8087
SHOPIFY_ADMIN_TARGET_PORT=8088
AKENEO_EVENT_BRIDGE_PORT=8090
N8N_PORT=5678

COMMERCE_INTEGRATION_SERVICE_URL=http://localhost:${COMMERCE_INTEGRATION_SERVICE_PORT}
MOCK_WMS_URL=http://localhost:${MOCK_WMS_PORT}
MOCK_PIM_URL=http://localhost:${MOCK_PIM_PORT}
GOVERNANCE_SERVICE_URL=http://localhost:${GOVERNANCE_SERVICE_PORT}
PRODUCT_PROJECTION_SERVICE_URL=http://localhost:${PRODUCT_PROJECTION_SERVICE_PORT}
MOCK_SHOPIFY_URL=http://localhost:${MOCK_SHOPIFY_PORT}
SHOPIFY_ADMIN_TARGET_URL=http://localhost:${SHOPIFY_ADMIN_TARGET_PORT}
AKENEO_EVENT_BRIDGE_URL=http://localhost:${AKENEO_EVENT_BRIDGE_PORT}
N8N_URL=http://localhost:5678

# Product target selection. Keep mock mode by default.
PRODUCT_PROJECTION_TARGET=mock-shopify
PRODUCT_TARGET_URL=http://mock-shopify:8087

# Live Shopify target. Keep values blank here; put real values only in private .env.
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ADMIN_AUTH_MODE=token
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-04
SHOPIFY_DELETE_MODE=archive

# Optional Hydrogen storefront. Keep real tokens only in private .env.
HYDROGEN_PORT=3000
PUBLIC_STORE_DOMAIN=
PUBLIC_STOREFRONT_ID=
PUBLIC_STOREFRONT_API_TOKEN=
PRIVATE_STOREFRONT_API_TOKEN=
PUBLIC_STOREFRONT_API_VERSION=2026-04
PUBLIC_CHECKOUT_DOMAIN=

# Local-only Akeneo bridge. The setup script computes the Akeneo container gateway by default.
AKENEO_WEBHOOK_CONNECTION_CODE=context_lab
AKENEO_WEBHOOK_SECRET=local-dev-webhook-secret

# Local-only dump target. Do not use this as production storage.
MOCK_SHOPIFY_DUMP_DIR=.local/mock-shopify-dumps

# Local n8n database placeholders. Replace in a private .env for real work.
N8N_POSTGRES_USER=n8n
N8N_POSTGRES_PASSWORD=local-only-not-a-secret
N8N_POSTGRES_DB=n8n
