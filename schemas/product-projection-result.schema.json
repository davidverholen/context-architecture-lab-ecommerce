{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://context-architecture-commerce-lab.local/schemas/product-projection-result.schema.json",
  "title": "Product Projection Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "result_id",
    "job_id",
    "status",
    "target",
    "projected_at",
    "projection",
    "errors"
  ],
  "properties": {
    "result_id": { "type": "string", "minLength": 1 },
    "job_id": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["accepted", "rejected", "review_required"] },
    "operation": { "type": "string", "enum": ["upsert", "archive", "delete", "noop"] },
    "target": { "type": "string", "enum": ["mock-shopify", "shopify-dev-store"] },
    "projected_at": { "type": "string" },
    "projection": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "projection_id",
            "pim_product_id",
            "shopify_status",
            "title",
            "handle",
            "vendor",
            "product_type",
            "description",
            "variants",
            "metafields",
            "metaobjects"
          ],
          "properties": {
            "projection_id": { "type": "string" },
            "pim_product_id": { "type": "string" },
            "shopify_status": { "type": "string", "enum": ["draft", "active", "archived"] },
            "title": { "type": "string" },
            "handle": { "type": "string" },
            "vendor": { "type": "string" },
            "product_type": { "type": "string", "enum": ["Rug"] },
            "description": { "type": "string" },
            "variants": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["sku", "price", "option_values"],
                "properties": {
                  "sku": { "type": "string" },
                  "price": { "type": "number", "minimum": 0 },
                  "option_values": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["size", "color"],
                    "properties": {
                      "size": { "type": "string" },
                      "color": { "type": "string" }
                    }
                  }
                }
              }
            },
            "metafields": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["namespace", "key", "type", "value"],
                "properties": {
                  "namespace": { "type": "string" },
                  "key": { "type": "string" },
                  "type": { "type": "string" },
                  "value": {
                    "oneOf": [
                      { "type": "string" },
                      { "type": "number" },
                      {
                        "type": "array",
                        "items": { "type": "string" }
                      }
                    ]
                  }
                }
              }
            },
            "metaobjects": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "handle", "fields"],
                "properties": {
                  "type": { "type": "string" },
                  "handle": { "type": "string" },
                  "fields": { "type": "object" }
                }
              }
            }
          }
        }
      ]
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "AKENEO_EXPORT_INVALID",
              "PIM_PRODUCT_INCOMPLETE",
              "PROJECTION_MAPPING_MISSING",
              "SHOPIFY_DOCS_VERIFICATION_REQUIRED",
              "TARGET_UNAVAILABLE"
            ]
          },
          "message": { "type": "string" }
        }
      }
    },
    "dump_path": { "type": "string" },
    "target_reference": { "type": "string" }
  }
}
