{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://context-architecture-commerce-lab.local/schemas/canonical-order.schema.json",
  "title": "Canonical Order",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "order_id",
    "source",
    "source_order_id",
    "created_at",
    "currency",
    "customer",
    "shipping_address",
    "line_items",
    "totals",
    "idempotency_key"
  ],
  "properties": {
    "order_id": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "enum": ["shopify"] },
    "source_order_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string" },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "customer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["customer_id", "email"],
      "properties": {
        "customer_id": { "type": "string" },
        "email": { "type": "string" }
      }
    },
    "shipping_address": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "address1", "city", "postal_code", "country_code"],
      "properties": {
        "name": { "type": "string" },
        "address1": { "type": "string" },
        "address2": { "type": "string" },
        "city": { "type": "string" },
        "postal_code": { "type": "string" },
        "country_code": { "type": "string", "pattern": "^[A-Z]{2}$" }
      }
    },
    "line_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["line_item_id", "sku", "title", "quantity", "unit_price", "product_family", "attributes"],
        "properties": {
          "line_item_id": { "type": "string" },
          "sku": { "type": "string" },
          "title": { "type": "string" },
          "quantity": { "type": "integer", "minimum": 1 },
          "unit_price": { "type": "number", "minimum": 0 },
          "product_family": { "type": "string", "enum": ["rug"] },
          "attributes": {
            "type": "object",
            "additionalProperties": false,
            "required": ["material", "size", "color", "shape"],
            "properties": {
              "material": { "type": "string" },
              "size": { "type": "string" },
              "color": { "type": "string" },
              "shape": { "type": "string" }
            }
          }
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subtotal", "shipping", "tax", "grand_total"],
      "properties": {
        "subtotal": { "type": "number", "minimum": 0 },
        "shipping": { "type": "number", "minimum": 0 },
        "tax": { "type": "number", "minimum": 0 },
        "grand_total": { "type": "number", "minimum": 0 }
      }
    },
    "idempotency_key": { "type": "string", "minLength": 1 }
  }
}
